---
import { t, getLocalePath, type Locale } from "@/i18n";
import { getNavPages } from "@/lib/nav";
import GlobeIcon from "@/components/GlobeIcon.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const i = t(locale);
const otherLocale: Locale = locale === "ja" ? "en" : "ja";
const otherPath = getLocalePath(otherLocale, currentPath);
const homeHref = getLocalePath(locale, "/");
const isHome = currentPath === "/" || currentPath === "";
const anchorHref = (id: string) => (isHome ? `#${id}` : `${homeHref}#${id}`);

const pages = getNavPages(locale);

const anchors = [
  { label: i.menu.activities, href: anchorHref("activities") },
  { label: i.about.label, href: anchorHref("about") },
  { label: i.menu.info, href: anchorHref("info") },
  { label: i.menu.lessons, href: anchorHref("lessons") },
  { label: i.menu.links, href: anchorHref("links") },
  { label: i.menu.contact, href: anchorHref("contact") },
];
---

<button
  type="button"
  id="hamburger-open"
  aria-label={i.menu.openLabel}
  aria-haspopup="dialog"
  aria-controls="hamburger-dialog"
  aria-expanded="false"
  class="relative inline-flex items-center justify-center w-10 h-10 -mr-2 cursor-pointer before:content-[''] before:absolute before:-inset-2"
>
  <span class="flex flex-col items-center justify-center gap-[6px]" aria-hidden="true">
    <span class="w-6 h-[2px] bg-ink"></span>
    <span class="w-6 h-[2px] bg-ink"></span>
  </span>
</button>

<dialog id="hamburger-dialog" class="hamburger-dialog" aria-label={i.menu.dialogLabel} tabindex="-1">
  <div class="menu-sheet flex flex-col w-full h-full text-ink">
    <div class="w-full max-w-4xl mx-auto flex items-center justify-between px-5 pt-3 pb-2">
      <a
        href={homeHref}
        class="text-xs tracking-[3px] text-ink [@media(hover:hover)]:hover:text-primary"
        aria-label={i.nav.homeLink}
      >
        SAPPORO CHESS CLUB
      </a>
      <button
        type="button"
        data-hamburger-close
        aria-label={i.menu.closeLabel}
        class="relative inline-flex items-center justify-center w-10 h-10 -mr-2 text-ink cursor-pointer rounded-md before:content-[''] before:absolute before:-inset-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <nav class="menu-move flex-1 min-h-0 w-full max-w-4xl mx-auto px-5 pt-5 overflow-y-auto overscroll-contain" aria-label={i.nav.mainNav}>
      {pages.map((page) => (
        <a
          href={page.href}
          data-astro-prefetch
          class="block mb-4 [@media(hover:hover)]:hover:text-primary"
          aria-current={page.path === currentPath ? "page" : undefined}
        >
          <span class="text-3xl font-light">{page.label}</span>
        </a>
      ))}

      <hr class="border-0 border-t border-edge my-4" />

      <p class="text-xs uppercase tracking-wider text-muted mb-2">
        {i.menu.sectionLabel}
      </p>
      <div class="flex flex-col gap-2">
        {anchors.map((anchor) => (
          <a
            href={anchor.href}
            class="text-sm text-sub [@media(hover:hover)]:hover:text-primary"
          >
            {anchor.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="menu-move border-t border-edge">
      <div class="max-w-4xl mx-auto px-5 py-4">
        <a
          href={otherPath}
          class="flex items-center gap-2.5 text-sm text-sub [@media(hover:hover)]:hover:text-primary"
          aria-label={i.nav.switchLanguage}
          hreflang={otherLocale}
        >
          <GlobeIcon size={16} stroke="currentColor" strokeWidth={1.5} />
          {i.nav.languageFull}
        </a>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* <dialog> を全画面シートとして使う。showModal() で top-layer に入り、
     ESC / focus trap / inert backdrop がブラウザ側で自動的に機能する。 */
  .hamburger-dialog {
    /* 位置を明示する。Safari は閉じた瞬間に dialog を top-layer から外すので、
       UA 既定 (position: absolute) のままだと、退場フェードの間だけヘッダーの中へ
       ずれて描かれる */
    position: fixed;
    inset: 0;
    margin: 0;
    /* 開いた直後のフォーカス先 (tabindex="-1")。画面全体を囲む枠は出さない */
    outline: none;
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh; /* fallback */
    height: 100dvh;
    /* 幕はページの地色と同じにすること。iOS Safari 26+ は画面上下の帯 (時計まわり・
       ツールバーまわり) をページ側の色で塗り、全画面の dialog の色は拾わない。
       地色と違う色にすると、上下に地色の帯が残る (docs/mobile-compatibility.md)。
       幕は dialog 側に持つ。中身が動いても背後のページが透けない。
       prefers-reduced-motion は globals.css が全体で無効化。 */
    background: var(--color-white);
    color: inherit;
    overflow: hidden;
    opacity: 0;
    /* 閉じ時のトランジション。display/overlay の尺は .menu-move の退場以上に保つこと
       (短いと中身が消え切る前に display:none で切り落とされる)。 */
    transition:
      opacity var(--dur-quick) var(--ease-exit),
      overlay var(--dur-quick) var(--ease-exit) allow-discrete,
      display var(--dur-quick) var(--ease-exit) allow-discrete;
  }
  .hamburger-dialog[open] {
    opacity: 1;
    transition:
      opacity var(--dur-base) var(--ease-calm),
      overlay var(--dur-base) var(--ease-calm) allow-discrete,
      display var(--dur-base) var(--ease-calm) allow-discrete;
  }
  @starting-style {
    .hamburger-dialog[open] {
      opacity: 0;
    }
  }

  .menu-sheet {
    /* 幕を敷いてから中身を置くまでの間。完全に同時だと幕と中身が一塊で飛び込む */
    --dur-sheet-delay: 0.06s;
    padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
      env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
  }
  /* 中身の開閉アニメ。動かすのは上段より下だけ: 上段のロゴはページのヘッダーと
     同じ位置・同じ色で重なるので、動かすと二重にぶれて見える。
     既定を「表示状態」にするのが肝: dialog が [open] の間は中身が必ず可視になり、
     「開いてるのに中身だけ透明」という事故が起きない。 */
  .menu-move {
    opacity: 1;
    transform: translateY(0);
  }
  /* 閉じ（[open] が外れた瞬間〜display:none までの間）: 中身が下へ沈んで消える（開きの逆）。
     退場は遅らせない — 消えたいものが居座って見える。 */
  .hamburger-dialog:not([open]) .menu-move {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--dur-quick) var(--ease-exit),
      transform var(--dur-quick) var(--ease-exit);
  }
  /* 開き: 幕と尺を揃え、わずかに遅らせて置く。段取りが見えると同じ速さでも静かに感じる。 */
  .hamburger-dialog[open] .menu-move {
    transition:
      opacity var(--dur-base) var(--ease-calm) var(--dur-sheet-delay),
      transform var(--dur-base) var(--ease-calm) var(--dur-sheet-delay);
  }
  /* display:none からの初回描画に開きの transition を効かせる開始状態。開くたび再生。 */
  @starting-style {
    .hamburger-dialog[open] .menu-move {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .hamburger-dialog::backdrop {
    background: transparent;
  }
</style>

<script>
  const openBtn = document.getElementById("hamburger-open") as HTMLButtonElement | null;
  const dialog = document.getElementById("hamburger-dialog") as HTMLDialogElement | null;
  if (openBtn && dialog) {
    initHamburgerMenu(openBtn, dialog);
  }

  function initHamburgerMenu(openBtn: HTMLButtonElement, dialog: HTMLDialogElement) {
    // ページ遷移中フラグ。遷移リンクタップ時は覆いを維持したいので、
    // その間の visibilitychange による即閉じをスキップさせる。
    let navigating = false;

    // 閉じた後にフォーカスをトリガーへ戻すのは、キーボードで開いたときだけ。
    // タッチやマウスで戻すと、押してもいないボタンにフォーカス枠が出る。
    let openedByKeyboard = false;

    /** メニューを開く。開閉アニメは CSS (transition + @starting-style) が担う。*/
    function openMenu(event: MouseEvent) {
      // キーボードで押した click は detail が 0 になる (マウス・タッチは 1 以上)
      openedByKeyboard = event.detail === 0;
      dialog.showModal();
      // フォーカスは dialog 自身に置く。showModal() は既定で最初のボタンやリンクへ
      // フォーカスを移し、タッチ操作でもそこにフォーカス枠が出てしまう。
      // dialog に置けば枠は出ず、Tab を押せば上段のリンクから順に回る。
      dialog.focus({ preventScroll: true });
      openBtn.setAttribute("aria-expanded", "true");
    }

    /** メニューを閉じる（CSS のフェードアウト付き）。*/
    function closeMenu() {
      dialog.close();
    }

    /**
     * transition を挟まず即座に閉じる。close() は exit transition (allow-discrete) を
     * 走らせるため、bfcache 凍結や PWA バックグラウンドが transition の途中に起きると
     * dialog が「幕のフェード途中」の状態で捕捉され、復元時に画面が幕で覆われたままになる。
     * それを防ぐため、凍結/バックグラウンド時はアニメを外して即座に閉じる。
     */
    function closeInstant() {
      if (!dialog.open) return;
      dialog.style.transition = "none";
      dialog.close();
      requestAnimationFrame(() => { dialog.style.transition = ""; });
    }

    // 起動/復元時に dialog が [open] のまま描画されると、幕が画面を覆って
    // 真っ黒に見える。初期化時に開いていたら即座に閉じる（安全網）。
    closeInstant();

    /**
     * 同一ページ内アンカー用: メニューを閉じ、ヘッダー headroom を一時凍結する。
     * 凍結により、スクロール先まで移動する間にヘッダーが消えなくなる。
     */
    function closeMenuAndFreezeHeader() {
      closeMenu();
      window.dispatchEvent(new CustomEvent("headroom:freeze"));
    }

    openBtn.addEventListener("click", openMenu);

    // 回転・Fold の開閉でナビが切り替わったらモーダル状態を解除する。
    // ブレークポイントの数値を JS に複製せず、実際のトリガー表示で判定する。
    window.addEventListener("resize", () => {
      if (dialog.open && !openBtn.getClientRects().length) closeInstant();
    });

    // close: キーボード操作ならトリガーへフォーカス復帰 (ESC の a11y)
    dialog.addEventListener("close", () => {
      openBtn.setAttribute("aria-expanded", "false");
      if (!openedByKeyboard) {
        // ブラウザが自動で戻したフォーカスも外す
        openBtn.blur();
        return;
      }
      // Fold 展開後など、トリガーが非表示ならデスクトップ側へ戻す。
      const focusTarget = openBtn.getClientRects().length
        ? openBtn
        : document.querySelector<HTMLAnchorElement>("#site-header nav a");
      focusTarget?.focus({ preventScroll: true });
    });

    // dialog 内クリックのデリゲート処理
    dialog.addEventListener("click", (e) => {
      const target = e.target as Element;
      if (target.closest("[data-hamburger-close]")) {
        closeMenu();
        return;
      }
      const link = target.closest("a[href]") as HTMLAnchorElement | null;
      const href = link?.getAttribute("href");
      if (!href) return;
      if (href.includes("#")) {
        // 同一ページ内 (#id) でも cross-page (/path#id) でもアンカーなら閉じる
        closeMenuAndFreezeHeader();
        return;
      }
      // その他のリンク (ページ遷移) では意図的に閉じない。
      // dialog を top-layer に残すことで、新ページが描画されるまで古いページを
      // 覆い隠せて、リンクタップ時のちらつきを防げる。
      // 遷移中は覆いを維持したいので、visibilitychange 側の即閉じをスキップさせる
      // （bfcache 対策は下の pagehide が担当）。
      navigating = true;
    });

    // 凍結/バックグラウンド時は即座に閉じ、真っ暗な状態で捕捉されるのを防ぐ。
    // - pagehide: bfcache 凍結直前（通常のページ遷移や離脱）。
    // - visibilitychange(hidden): PWA バックグラウンド（pagehide が発火しない環境）。
    //   ただしページ遷移中(navigating)は覆いを維持したいのでスキップ。
    // - pageshow(persisted): bfcache 復元時の safety net。
    window.addEventListener("pagehide", closeInstant);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden" && !navigating) closeInstant();
    });
    window.addEventListener("pageshow", (e: PageTransitionEvent) => {
      if (e.persisted) {
        navigating = false;
        closeInstant();
      }
    });
  }
</script>
